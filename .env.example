# Copy to .env and fill values. Never commit .env.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Optional: only needed when you enable cloud object storage later
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Local paths (default relative to project root)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
SQLITE_PATH=db/tr_market_data.sqlite

# Dukascopy politeness
DUKASCOPY_MIN_INTERVAL_SEC=0.35
DUKASCOPY_MAX_RETRIES=5
