# Copy to .env — never commit .env

TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs (admins only in Phase 2B)
TELEGRAM_ADMIN_IDS=

# Private channel (or group) where the bot posts finished Parquet files.
# The bot must be an administrator with Post Messages permission.
# Example: -1001234567890
TELEGRAM_STORAGE_CHANNEL_ID=

# Project paths (defaults work from repo root)
SQLITE_PATH=db/tr_market_data.sqlite
DATA_ROOT=data

# Optional rate limit (commands per user per minute)
BOT_RATE_LIMIT_PER_MINUTE=20

# Public access is disabled by default (Phase 2B)
BOT_PUBLIC_ACCESS=false

# Telegram private channel archive (disabled by default)
TELEGRAM_ARCHIVE_ENABLED=false
TELEGRAM_ARCHIVE_CHANNEL_ID=
ARCHIVE_MAX_RETRIES=8
ARCHIVE_BACKOFF_BASE_SEC=30
ARCHIVE_BACKOFF_CAP_SEC=3600
ALLOW_DELETE_STAGING=false
